#!/usr/bin/env bash
# Prepares an Amp orb for grapheneX development: Python 3.10 (as in CI and the
# Dockerfile), Poetry, Ruff, and the project's locked dependencies in ./.venv.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

PYTHON_VERSION=3.10
POETRY_VERSION=1.8.5 # poetry.lock was generated by Poetry 1.8.x
export POETRY_NO_INTERACTION=1
export POETRY_VIRTUALENVS_IN_PROJECT=1
export PATH="$HOME/.local/bin:$PATH"

step() {
	local name="$1"
	shift
	local start=$SECONDS
	echo "==> $name"
	"$@"
	echo "<== $name ($((SECONDS - start))s)"
}

install_python() {
	uv python install "$PYTHON_VERSION"
}

install_tools() {
	if ! poetry --version 2>/dev/null | grep -Fq "$POETRY_VERSION"; then
		uv tool install --force "poetry==$POETRY_VERSION"
	fi
	if ! command -v ruff >/dev/null; then
		uv tool install ruff
	fi
	# Keep the virtualenv in ./.venv (gitignored) for later `poetry` commands too.
	poetry config virtualenvs.in-project true
}

install_dependencies() {
	poetry env use "$(uv python find "$PYTHON_VERSION")"
	poetry install --no-ansi
}

# prompt_toolkit 1.x (pulled in by PyInquirer) imports Mapping from
# `collections`, which Python 3.10 removed. CI and the Dockerfile patch it too:
# https://github.com/grapheneX/grapheneX/issues/127
patch_prompt_toolkit() {
	local file
	file="$(.venv/bin/python -c 'import importlib.util as u; print(u.find_spec("prompt_toolkit").submodule_search_locations[0])')/styles/from_dict.py"
	sed -i 's/^from collections import Mapping$/from collections.abc import Mapping/' "$file"
}

step "Python $PYTHON_VERSION" install_python
step "Poetry and Ruff" install_tools
step "Project dependencies" install_dependencies
step "prompt_toolkit patch" patch_prompt_toolkit
step "Smoke test" .venv/bin/python -c 'import graphenex.__main__'
